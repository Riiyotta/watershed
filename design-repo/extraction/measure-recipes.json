      { "section": "story.body", "el": "main > div aside + div" },
      { "section": "shared.page-links", "el": "main > section", "optional": true }
    ],
    "template.customer-story-editorial": [
      { "section": "shared.post-hero", "el": "main > :nth-child(1)" },
      { "section": "shared.article-body", "el": "main > :nth-child(2)" },
      { "section": "shared.newsletter-band", "el": "main > :nth-child(3)" },
      { "section": "shared.related-content", "el": "main > :nth-child(4)" }
    ],
    "template.blog-post": [
