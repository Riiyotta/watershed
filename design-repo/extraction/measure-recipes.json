      { "section": "customers.filter-bar", "el": "main > :nth-child(4) .cust-grid-head" },
      { "section": "customers.customer-grid", "el": "main > :nth-child(4) ul" },
      { "section": "customers.quote-carousel", "el": "main > :nth-child(5)" },
