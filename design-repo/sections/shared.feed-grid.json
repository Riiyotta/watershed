{
  "id": "shared.feed-grid",
  "kind": "shared",
  "category": "cards",
  "title": "Feed grid",
  "purpose": "Filter chips, optional search, a 3x352px grid of feed cards with a newsletter band inserted after the sixth card and a Load more button that appends 12 at a time.",
  "content": {
    "fields": {
      "itemSource": {
        "type": "enum",
        "values": [
          "blog-posts",
          "guides-and-guide-posts",
          "events"
        ],
        "required": true
      },
      "chips": {
        "type": "list",
        "items": {
          "type": "object",
          "fields": {
            "slug": {
              "type": "enum",
              "values": [
                "product-updates",
                "guides",
                "sustainability-ai",
                "customer-stories",
                "policy",
                "tech-design",
                "webinars",
                "in-person",
                "demos",
                "office-hours",
                "summits",
                "policy-briefings",
                "on-demand"
              ],
              "required": true
            },
            "label": {
              "type": "text",
              "maxWords": 3,
              "required": true,
              "budgetBasis": "observed 3 words (Policy briefings)",
              "evidenceLevel": "derived"
            }
          },
          "required": true
        },
        "minItems": 0,
        "required": false,
        "maxItems": 7,
        "budgetBasis": "/blog has 6 chips plus All, /events 7 plus All, /guides none"
      },
      "search": {
        "type": "boolean",
        "required": false
      },
      "pageSize": {
        "type": "integer",
        "required": false,
        "minimum": 12,
        "maximum": 12
      },
      "newsletterInset": {
        "type": "boolean",
        "required": false
      }
    },
    "additionalProperties": false
  },
  "variants": [
    {
      "id": "blog",
      "description": "Chips and search."
    },
    {
      "id": "guides",
      "description": "No chips, no search."
    },
    {
      "id": "events",
      "description": "Chips only."
    }
  ],
  "variantRequired": true,
  "variantRules": [],
  "constraints": {
    "onePerPage": true,
    "mustFollowSection": "shared.featured-carousel"
  },
  "motion": {
    "patterns": [
      {
        "pattern": "state-transition",
        "reducedMotionFallback": "transition-unchanged",
        "implementedInClone": true,
        "note": "chip, card and title hover transitions .2s are not gated"
      }
    ]
  },
  "responsive": {
