{
  "id": "shared.post-hero",
  "kind": "shared",
  "category": "hero",
  "title": "Post hero",
  "purpose": "Grey hero under the translucent nav for blog posts and editorial customer stories: breadcrumbs, 16:9 media, mono date, H1 and optional subtitle.",
  "content": {
    "fields": {
      "breadcrumbs": {
        "type": "list",
        "items": {
          "type": "link",
          "maxWords": 3,
          "required": true,
          "budgetBasis": "observed 3 words",
          "evidenceLevel": "derived"
        },
        "minItems": 2,
        "required": true,
        "maxItems": 2
      },
      "date": {
        "type": "text",
        "maxWords": 4,
        "required": false,
        "budgetBasis": "observed-max 4 words in generated post dates",
        "evidenceLevel": "derived"
      },
      "title": {
        "type": "text",
        "maxWords": 15,
        "required": true,
        "budgetBasis": "observed-max 15 words over the 251 generated post titles; story titles reach 14",
        "evidenceLevel": "derived"
      },
      "subtitle": {
        "type": "text",
        "maxWords": 7,
        "required": false,
        "budgetBasis": "observed-max 7 words",
        "evidenceLevel": "derived"
      },
      "image": {
        "type": "asset",
        "allowedRoles": [
          "photo.environment",
          "photo.business-setting"
        ],
        "required": true,
        "altText": true
      }
    },
    "additionalProperties": false
  },
  "variants": [],
  "variantRequired": false,
  "variantRules": [],
  "constraints": {
    "onePerPage": true,
    "mustFollowNav": true
  },
  "motion": {
    "patterns": [
      {
        "pattern": "none",
        "reducedMotionFallback": "not-applicable",
        "implementedInClone": true
      },
      {
        "pattern": "state-transition",
        "reducedMotionFallback": "transition-unchanged",
        "implementedInClone": true,
        "note": "button and link hover and focus colour transitions (.12s buttons, .15s links) are not gated"
      }
    ]
  },
  "responsive": {
    "breakpoints": [
      {
        "viewport": {
          "name": "mobile",
          "minWidth": 0,
          "maxWidth": 767,
          "measuredAt": 390
        },
        "layout": {
          "padding": "89px 0 43px",
          "order": "media first (358x201)",
          "h1": "24/30 -0.72",
          "subtitle": "14/21",
          "crumbs": "10/15"
        },
        "evidenceLevel": "measured"
      },
      {
        "viewport": {
          "name": "tablet",
          "minWidth": 768,
          "maxWidth": 1023,
          "measuredAt": null
        },
        "layout": {
          "rule": "inherits the stacked mobile layout in the clone below 1024px; original never measured here",
          "switchesAtPx": 1024
        },
        "evidenceLevel": "inferred"
      },
      {
        "viewport": {
          "name": "desktop-narrow",
          "minWidth": 1024,
          "maxWidth": 1279,
          "measuredAt": null
        },
        "layout": {
          "rule": "same as desktop: the clone switches to the desktop layout at 1024; the original was not measured in this band",
          "switchesAtPx": 1024
        },
        "evidenceLevel": "inferred"
      },
      {
        "viewport": {
          "name": "desktop",
          "minWidth": 1024,
          "maxWidth": null,
          "measuredAt": 1440
        },
        "layout": {
          "section": "margin-top -68px, padding 100 0 64",
          "grid": "552px + 552px, gap 48; media 552x311 16:9; H1 36/45"
        },
        "evidenceLevel": "measured"
      }
    ],
    "citations": [
      {
        "ref": "PAGES_SPEC.md:177-188",
        "anchor": "### 2.3 `PostHero`"
      },
      {
        "ref": "src/primitives/PostHero.jsx:6-24",
        "anchor": "export default function PostHero"
      }
    ]
  },
  "a11y": [
    "Breadcrumbs are an ordered list in a labelled nav.",
    "Single H1."
  ],
  "assetRoles": [
    "photo.business-setting",
    "photo.environment"
  ],
  "styleTokens": [
    "surface.subtle",
    "role.date-mono",
    "role.h2-feature"
  ],
  "evidence": {
    "level": {
      "desktop": "measured",
      "mobile": "measured",
      "tablet": "inferred"
    },
    "citations": [
